<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="lemgo.net.xml"/>
        <route-files value="cars.rou.xml,bikes.rou.xml,pedestrians_safe.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="1800"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="300"/>
        <collision.action value="warn"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>
</configuration>
